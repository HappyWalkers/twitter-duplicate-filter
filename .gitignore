.DS_Store
browser_action.html
manifest.json
node_modules/
promo/*.png
!promo/app-store.png
scripts/locales/base-translations.json
scripts/locales/html/*.html
scripts/locales/js/*.js
scripts/locales/js/_files.txt
scripts/locales/locales.js
scripts/locales/old/
