web-ext-artifacts/
# --- semantic dedup fork ---
# NOTE: gitignore has no trailing comments -- a '#' only starts a comment at the start of
# a line, so "dist-dedup/  # build output" is a literal pattern that matches nothing.
.venv/

# Build output; ./scripts/build-dedup.sh regenerates it.
dist-dedup/

# Embedding cache (386MB), regenerated by benchmark.py on demand.
data/emb/
data/__pycache__/

# 267MB, stale, and over GitHub's 100MB per-file limit.
data/gold_pairs.superseded.json

# Enumerated pairs; gold_pairs_compact.json is the source of truth and expands to these.
data/gold_pairs.json

data/*.log
data/*.backup.json
data/benchmark_results_oldgold.json
data/benchmark_results_partial.json

# The raw scraped corpus: 14k tweets with full text and author handles. Only the
# statusId -> story-id labels are committed (the conventional "dehydrated" form for a
# tweet dataset), so the gold stays inspectable and re-derivable without this repo
# redistributing other people's posts. Re-collect it with data/capture.py.
data/posts.jsonl

# Store build output and the bundled model weights (157MB, over GitHub's file limit).
# scripts/build-store.sh reassembles both; see store/README.md for where the model comes from.
dist-store/
dist-store.zip
store/models/
